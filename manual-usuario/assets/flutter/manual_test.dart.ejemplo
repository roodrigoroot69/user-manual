// Ejemplo: integration_test/manual_test.dart — adaptar el main de la app, keys y textos.
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:integration_test/integration_test.dart';

import 'package:ruta/main.dart' as app;
import 'manual/manual_capturador.dart';

void main() {
  final binding = IntegrationTestWidgetsFlutterBinding.ensureInitialized();
  final cap = ManualCapturador(binding, ocultarSiempre: [find.byKey(const ValueKey('lblVendedor'))]);

  testWidgets('levantar-pedido', (tester) async {
    // La app debe arrancar en modo demo (base local limpia, sin impresora real).
    // Ver references/flutter.md → "Datos de demo".
    app.main();
    await tester.pumpAndSettle();

    await cap.captura(tester, 'levantar-pedido-01')
        .resaltar(find.byKey(const ValueKey('btnNuevoPedido')))
        .guardar();

    await tester.tap(find.byKey(const ValueKey('btnNuevoPedido')));
    await tester.pumpAndSettle();

    await tester.tap(find.text('Abarrotes Doña Mari'));
    await tester.pumpAndSettle();
    await cap.captura(tester, 'levantar-pedido-02')
        .resaltar(find.text('Abarrotes Doña Mari'))
        .guardar();

    await tester.enterText(find.byKey(const ValueKey('txtBuscarProducto')), 'arroz');
    await tester.pumpAndSettle();
    await cap.captura(tester, 'levantar-pedido-03')
        .resaltar(find.byKey(const ValueKey('txtBuscarProducto')))
        .resaltar(find.text('Arroz 1kg').first)
        .guardar();

    await tester.tap(find.byKey(const ValueKey('btnConfirmarPedido')));
    await tester.pumpAndSettle();
    await cap.captura(tester, 'levantar-pedido-04')
        .resaltar(find.byType(SnackBar), numero: false)
        .guardar();
  });
}
