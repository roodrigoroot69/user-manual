// Ejemplo: adaptar paquete, clase principal, ids y la forma de apuntar a la base demo.
package manual;

import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.testfx.api.FxRobot;
import org.testfx.framework.junit5.ApplicationExtension;
import org.testfx.framework.junit5.Start;
import org.testfx.util.WaitForAsyncUtils;

import javafx.stage.Stage;
import java.nio.file.*;

@Tag("manual")
@ExtendWith(ApplicationExtension.class)
class ManualCapturaTest {

    static final Path SALIDA = Path.of(System.getProperty("manual.salida", "build/manual/crudas"));
    static final ManualCapturador cap = new ManualCapturador(SALIDA, 2)
            .ocultarSiempre("#lblUsuarioActual");   // datos del usuario en la barra superior

    Stage stage;

    @Start
    void start(Stage stage) throws Exception {
        // Base de demo limpia para cada sección
        Path demo = Path.of("build/manual/demo.db");
        Files.createDirectories(demo.getParent());
        Files.copy(Path.of("src/test/resources/manual/demo.db"), demo, StandardCopyOption.REPLACE_EXISTING);
        System.setProperty("app.db", demo.toString());
        System.setProperty("app.modo", "demo");       // sin sincronización ni respaldos

        new com.distribuidora.App().start(stage);     // tu clase principal
        stage.setWidth(1366);
        stage.setHeight(768);
        this.stage = stage;
    }

    private void listo() { WaitForAsyncUtils.waitForFxEvents(); }

    @Test
    void registrarEntrada(FxRobot robot) {
        listo();
        cap.captura(stage, "registrar-entrada-01").resaltar("#menuInventario").guardar();

        robot.clickOn("#menuInventario"); listo();
        cap.captura(stage, "registrar-entrada-02").resaltar("#btnNuevaEntrada").guardar();

        robot.clickOn("#btnNuevaEntrada"); listo();
        robot.clickOn("#cmbProducto"); listo();
        cap.captura(stage, "registrar-entrada-03").pantalla()   // lista abierta = ventana emergente
                .resaltar("#cmbProducto").guardar();

        robot.clickOn("Arroz 1kg");
        robot.clickOn("#txtCantidad").write("48"); listo();
        cap.captura(stage, "registrar-entrada-04")
                .resaltar("#cmbProducto").resaltar("#txtCantidad")
                .recortar("#formEntrada", 16).guardar();

        robot.clickOn("#btnGuardar"); listo();
        cap.captura(stage, "registrar-entrada-05").resaltar("#lblConfirmacion", null).guardar();
    }
}
